{
  // zurielst-site: static assets ONLY. No bindings, no secrets, no Durable
  // Objects, so per-version preview URLs work (plan rev 3, F1/R2 findings).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zurielst-site",
  "compatibility_date": "2025-09-06",
  "assets": {
    "directory": "../../out",
    "not_found_handling": "404-page"
  },
  // Preview URLs are the review surface; production routes are attached only
  // at the M12 cutover (zurielst.com/* and www.zurielst.com/*), never before.
  "workers_dev": false,
  "preview_urls": true
}
