{
  // CUTOVER OVERLAY for zurielst-chat-api (phase 2, plan M12 choreography).
  // Identical to wrangler.jsonc plus the exact API routes. Deployed once by
  // the operator locally with wrangler OAuth (the CI token deliberately lacks
  // route permissions); CI keeps deploying the routeless wrangler.jsonc,
  // which leaves routes attached. Rollback: delete both routes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zurielst-chat-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "DAILY_BUDGET", "class_name": "DailyBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }],
  "unsafe": {
    "bindings": [
      {
        "type": "ratelimit",
        "name": "RATE_LIMITER",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },
  "vars": {
    "DAILY_CAP": "120",
    "ALLOWED_HOSTS": "zurielst.com,staging.zurielst.com"
  },
  "routes": [
    { "pattern": "zurielst.com/api/chat", "zone_name": "zurielst.com" },
    { "pattern": "staging.zurielst.com/api/chat", "zone_name": "zurielst.com" }
  ]
}
